# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_db

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional for local, required for Qdrant Cloud

# Ollama Cloud (for LLM / research agents)
# Get API key from ollama.com
OLLAMA_CLOUD_URL=https://api.ollama.com
OLLAMA_API_KEY=ollama_your_key_here

# Google Gemini (for RAG embeddings - free tier)
# Get your free API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_EMBED_MODEL=gemini-embedding-2-preview

# Models (Ollama cloud model for LLM tasks)
LLM_MODEL=deepseek-v3.2

# API
CORS_ORIGINS=http://localhost:3000
